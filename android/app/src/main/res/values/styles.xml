<?xml version="1.0" encoding="utf-8"?>
<!-- There is deliberately no values-night variant. The app pins
     ThemeMode.light, so the OS dark-mode setting must not change how it looks;
     the Flutter template's night styles inherited Theme.Black.NoTitleBar and
     flashed black before the first frame. Night qualifiers also outrank version
     qualifiers, so a values-night file would defeat values-v31 below. -->
<resources>
    <!-- Applied to the Android Window while the process is starting. Removed
         automatically once the Flutter engine draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Applied as soon as the process has started: visible while the Flutter
         UI initialises, and behind it while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
